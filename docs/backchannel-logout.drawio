<mxfile host="drawio">
  <diagram id="bcl" name="Back-channel logout">
    <mxGraphModel adaptiveColors="auto" dx="1000" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;b&gt;ThunderID back-channel logout in ASP.NET Core&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="20" y="-30" width="520" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="ll1" value="Browser A&lt;br&gt;(Alice, signed in)" style="shape=umlLifeline;perimeter=lifelinePerimeter;html=1;container=0;collapsible=0;recursiveResize=0;size=50;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="160" height="660" as="geometry"/>
        </mxCell>
        <mxCell id="ll2" value="WebApp :7101&lt;br&gt;(ThunderID.AspNetCore)" style="shape=umlLifeline;perimeter=lifelinePerimeter;html=1;container=0;collapsible=0;recursiveResize=0;size=50;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="250" y="20" width="160" height="660" as="geometry"/>
        </mxCell>
        <mxCell id="ll3" value="ThunderID :8090" style="shape=umlLifeline;perimeter=lifelinePerimeter;html=1;container=0;collapsible=0;recursiveResize=0;size=50;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="480" y="20" width="160" height="660" as="geometry"/>
        </mxCell>
        <mxCell id="ll4" value="Somewhere else&lt;br&gt;(other tab, app or admin)" style="shape=umlLifeline;perimeter=lifelinePerimeter;html=1;container=0;collapsible=0;recursiveResize=0;size=50;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="710" y="20" width="160" height="660" as="geometry"/>
        </mxCell>
        <mxCell id="m1" value="GET /Profile (cookie, sid=S)" style="html=1;endArrow=block;endFill=1;verticalAlign=bottom;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="100" y="110" as="sourcePoint"/>
            <mxPoint x="330" y="110" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="m2" value="200 profile page" style="html=1;endArrow=open;endFill=0;dashed=1;verticalAlign=bottom;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="330" y="150" as="sourcePoint"/>
            <mxPoint x="100" y="150" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="m3" value="GET /oauth2/logout" style="html=1;endArrow=block;endFill=1;verticalAlign=bottom;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="790" y="210" as="sourcePoint"/>
            <mxPoint x="560" y="210" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="n1" value="Delete session S" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="565" y="225" width="130" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="m4" value="302 redirect&lt;br&gt;(doesn't wait for delivery)" style="html=1;endArrow=open;endFill=0;dashed=1;verticalAlign=bottom;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="560" y="300" as="sourcePoint"/>
            <mxPoint x="790" y="300" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="m5" value="POST /backchannel-logout&lt;br&gt;logout_token (signed logout+jwt, sid=S)" style="html=1;endArrow=block;endFill=1;verticalAlign=bottom;strokeWidth=2;strokeColor=#6c8ebf;fontStyle=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="560" y="345" as="sourcePoint"/>
            <mxPoint x="330" y="345" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="n2" value="&lt;b&gt;LogoutTokenValidator&lt;/b&gt;&lt;br&gt;typ, signature, iss, aud, iat/exp,&lt;br&gt;events, no nonce, sid or sub, jti&lt;br&gt;&lt;b&gt;ILogoutSessionStore&lt;/b&gt;&lt;br&gt;record session S as ended" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=6;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="335" y="360" width="215" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="m6" value="200 OK (Cache-Control: no-store)" style="html=1;endArrow=open;endFill=0;dashed=1;verticalAlign=bottom;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="330" y="480" as="sourcePoint"/>
            <mxPoint x="560" y="480" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="m7" value="Refresh: GET /Profile&lt;br&gt;(same cookie, sid=S)" style="html=1;endArrow=block;endFill=1;verticalAlign=bottom;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="100" y="535" as="sourcePoint"/>
            <mxPoint x="330" y="535" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="n3" value="&lt;b&gt;Cookie OnValidatePrincipal&lt;/b&gt;&lt;br&gt;store says S ended:&lt;br&gt;RejectPrincipal, SignOutAsync" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=6;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="335" y="550" width="215" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="m8" value="302 to sign-in, cookie deleted" style="html=1;endArrow=open;endFill=0;dashed=1;verticalAlign=bottom;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="330" y="645" as="sourcePoint"/>
            <mxPoint x="100" y="645" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
