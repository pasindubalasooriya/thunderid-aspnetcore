@page
@model ProfileModel
@{
    ViewData["Title"] = "Profile";
}

<div class="d-flex align-items-center gap-3 mb-4">
    <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fs-3"
         style="width: 72px; height: 72px;">
        @UserDisplay.Initials(User)
    </div>
    <div>
        <h1 class="h3 mb-0">@UserDisplay.DisplayName(User)</h1>
        <div class="text-muted">@(UserDisplay.Email(User) ?? "No email")</div>
    </div>
</div>

<dl class="row">
    <dt class="col-sm-3">Given name</dt>
    <dd class="col-sm-9">@(UserDisplay.GivenName(User) ?? "Not provided")</dd>
    <dt class="col-sm-3">Family name</dt>
    <dd class="col-sm-9">@(UserDisplay.FamilyName(User) ?? "Not provided")</dd>
    <dt class="col-sm-3">Email</dt>
    <dd class="col-sm-9">@(UserDisplay.Email(User) ?? "Not provided")</dd>
</dl>

<form method="post" asp-page="/Account/SignOut">
    <button type="submit" class="btn btn-outline-danger">Sign out</button>
</form>
